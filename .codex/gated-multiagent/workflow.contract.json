{
  "contract_version": 1,
  "name": "ai-research-lab",
  "task": "Evidence-gated AI-assisted scientific research: route reviewed literature into falsifiable hypotheses, isolated computational experiments, independent replication, and auditable release decisions.",
  "reuse": {
    "shared_kernel": "C:\\Users\\Administrator\\Documents\\Codex\\2026-09-21\\w-zh\\outputs\\codex-science-workflow",
    "existing_framework": "ai_research_lab.router plus shared codex-science-workflow",
    "strategy": "adapter-first; do not fork shared gate or routing code"
  },
  "orchestrator": {
    "routing": "deterministic-dag",
    "fail_closed": true,
    "immutable_runs": true,
    "llm_may_choose_routes": false
  },
  "execution": {
    "shared_policy": "C:\\Users\\Administrator\\Documents\\Codex\\2026-09-21\\w-zh\\outputs\\codex-science-workflow\\integration\\policy.json",
    "network_default": "deny",
    "credentials_in_sandbox": false,
    "generated_code_entrypoint": "shared Interpreter.run() only"
  },
  "agents": [
    {
      "id": "analyst",
      "runtime": "codex-sdk",
      "fallback": "none",
      "role": "inspect existing assets and requirements"
    },
    {
      "id": "architect",
      "runtime": "codex-sdk",
      "fallback": "none",
      "role": "produce deterministic routes and gate placement"
    },
    {
      "id": "builder",
      "runtime": "codex-sdk",
      "fallback": "none",
      "role": "implement adapters around existing frameworks"
    },
    {
      "id": "verifier",
      "runtime": "codex-sdk",
      "fallback": "none",
      "role": "verify gates, routes, isolation, and failure behavior"
    },
    {
      "id": "reviewer",
      "runtime": "codex-sdk",
      "fallback": "none",
      "role": "audit evidence and release readiness"
    }
  ],
  "stages": [
    {
      "id": "evidence_intake",
      "agent": "analyst",
      "depends_on": [],
      "artifact": "artifacts/01-evidence.json",
      "gates": [
        "json-schema",
        "artifact-hash"
      ]
    },
    {
      "id": "hypothesis_portfolio",
      "agent": "architect",
      "depends_on": [
        "evidence_intake"
      ],
      "artifact": "artifacts/02-hypothesis-portfolio.json",
      "gates": [
        "json-schema",
        "artifact-hash",
        "human-approval"
      ],
      "requires_human_approval": true
    },
    {
      "id": "experiment_plan",
      "agent": "builder",
      "depends_on": [
        "hypothesis_portfolio"
      ],
      "artifact": "artifacts/03-experiment-plan.json",
      "gates": [
        "json-schema",
        "artifact-hash",
        "human-approval"
      ],
      "requires_human_approval": true
    },
    {
      "id": "isolated_experiment",
      "agent": "builder",
      "depends_on": [
        "experiment_plan"
      ],
      "artifact": "artifacts/04-isolated-experiment.json",
      "gates": [
        "json-schema",
        "artifact-hash",
        "codex-review",
        "container-execution"
      ],
      "may_execute_code": true,
      "execution_adapter": "src/ai_research_lab/execution.py"
    },
    {
      "id": "independent_replication",
      "agent": "verifier",
      "depends_on": [
        "isolated_experiment"
      ],
      "artifact": "artifacts/05-independent-replication.json",
      "gates": [
        "json-schema",
        "artifact-hash",
        "codex-review",
        "container-execution"
      ],
      "may_execute_code": true,
      "execution_adapter": "src/ai_research_lab/execution.py"
    },
    {
      "id": "claim_review",
      "agent": "reviewer",
      "depends_on": [
        "independent_replication"
      ],
      "artifact": "artifacts/06-claim-review.json",
      "gates": [
        "json-schema",
        "artifact-hash",
        "human-approval"
      ],
      "requires_human_approval": true
    }
  ],
  "backfill": {
    "mode": "dependency-closure",
    "preserve_old_runs": true
  }
}
